# IMPORTANT: load_dotenv is configured with override=True, meaning values in this file
# take precedence over already-exported shell variables.
#
# The app uses a single local SQLite database. DATABASE_PATH is the live DB used by
# the ORM and the raw-sqlite model read/write paths (export, model runs, trend
# backfill). The live DB must stay on local disk — data/scripts/backup_to_drive.sh
# snapshots it to Google Drive; never point this at the Drive mount directly.
export DATABASE_PATH=/home/philiph/dbs/elections.db

# Destination directory for the Google Drive database snapshots, used by
# data/scripts/backup_to_drive.sh / restore_from_drive.sh (the data console
# invokes these for its Backup / Restore buttons). The scheduled (systemd/cron)
# run does not load .env, so set this in that environment too if you rely on it.
export DRIVE_DBS_DIR="/mnt/f/My Drive/dbs"
