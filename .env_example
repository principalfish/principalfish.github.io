# IMPORTANT: load_dotenv is configured with override=True, meaning values in this file
# take precedence over already-exported shell variables.
#
# The app uses a single local SQLite database. DATABASE_PATH is the live DB used by
# the ORM and the raw-sqlite model read/write paths (export, model runs, trend
# backfill). The live DB must stay on local disk — data/core/backup.py archives it, and
# an hourly restic job outside the repo sends the newest copy to Backblaze B2.
export DATABASE_PATH=/home/philiph/dbs/elections.db

# Latest Westminster Monte Carlo draws, written by each Westminster model run
# (unless --no-raw-sims) and read by the console's Explore simulations pages.
# Reproducible, so not part of DB backups. Default is the path below.
export SIMULATIONS_PATH=/home/philiph/dbs/simulations/westminster-latest.npz

# Backups (data/core/backup.py; run by the data console after every write and on
# startup, and by data/scripts/backup_db.py from a terminal).
#
# ELECTIONS_ARCHIVE_DIR: local folder of dated elections-<UTC stamp>.db.gz
#   archives plus a plain newest elections.db. Default ~/dbs/elections.
# ELECTIONS_BACKUP_KEEP: how many local archives to keep. Default 30.
export ELECTIONS_ARCHIVE_DIR=/home/philiph/dbs/elections
export ELECTIONS_BACKUP_KEEP=30

# Console run log (data/console/shared/run_log.py): every command the data console
# launches is recorded under console-runs/ beside the database, outside git.
# CONSOLE_RUN_LOG_KEEP: how many run records to keep, oldest pruned first. Default 200.
# export CONSOLE_RUN_LOG_KEEP=200

# US results import (data/importers/results/us/nyt/fetch.py).
#
# NYT_CACHE_DIR: where downloaded NYT results JSON snapshots and their
#   <chamber>-<kind>-latest.json pointers are kept, one subfolder per year.
#   Default /home/philiph/dbs/nyt-cache (outside the repo).
# export NYT_CACHE_DIR=/home/philiph/dbs/nyt-cache
