# IMPORTANT: load_dotenv is configured with override=True, meaning values in this file
# take precedence over already-exported shell variables.
#
# The app uses a single local SQLite database. DATABASE_PATH is the live DB used
# by the ORM; SQLITE_DATABASE_PATH is the same file, used by the raw-sqlite model
# read/write paths (export, model runs, trend backfill). Keep them pointed at the
# same file. The live DB must stay on local disk — backup_to_drive.sh snapshots it
# to Google Drive; never point these at the Drive mount directly.
export DATABASE_PATH=/home/philiph/dbs/elections.db
export SQLITE_DATABASE_PATH=/home/philiph/dbs/elections.db

# Destination directory for the Google Drive database snapshots, used by
# backup_to_drive.sh / restore_from_drive.sh. The data console inherits this
# when it runs those scripts. The scheduled (systemd/cron) run does not load
# .env, so the scripts fall back to this same default if the var is unset.
export DRIVE_DBS_DIR="/mnt/f/My Drive/dbs"
