# IMPORTANT: load_dotenv is configured with override=True, meaning values in this file
# take precedence over already-exported shell variables.
#
# The app uses a single local SQLite database. DATABASE_PATH is the live DB used by
# the ORM and the raw-sqlite model read/write paths (export, model runs, trend
# backfill). The live DB must stay on local disk — data/backup.py archives it and
# pushes a copy to Google Drive; never point this at the Drive mount directly.
export DATABASE_PATH=/home/philiph/dbs/elections.db

# Backups (data/backup.py; run by the data console after every write and on
# startup, and by data/scripts/backup_db.py from a terminal).
#
# ELECTIONS_ARCHIVE_DIR: local folder of dated elections-<UTC stamp>.db.gz
#   archives plus a plain newest elections.db. Default ~/dbs/elections.
# ELECTIONS_BACKUP_KEEP: how many local archives to keep. Default 30.
# ELECTIONS_BACKUP_DIR: the Google Drive folder. It gets one file, elections.db.gz,
#   overwritten at most once a day (the console's Backup now button and
#   backup_db.py --push force it). Unset = no Drive copy.
#
# The Drive folder is the Google Drive for Desktop mount WSL sees as /mnt/g — not
# the Explorer "My Drive" shortcut under /mnt/c/Users/<name>/, which looks the
# same but syncs nothing. If Drive for Desktop restarts, /mnt/g goes stale ("No
# such device") and pushes are skipped until it is remounted:
#   sudo umount /mnt/g; sudo mount -t drvfs G: /mnt/g
export ELECTIONS_ARCHIVE_DIR=/home/philiph/dbs/elections
export ELECTIONS_BACKUP_KEEP=30
export ELECTIONS_BACKUP_DIR="/mnt/g/My Drive/dbs"
