# IMPORTANT: load_dotenv is configured with override=True, meaning values in this file
# take precedence over already-exported shell variables. To connect to local Docker
# instead of Supabase, unset or leave blank the SUPABASE_* vars below, or use
# DatabaseConfig.local() directly in code.
export SUPABASE_DB_PASSWORD=
export SUPABASE_DB_USERNAME=
export SUPABASE_REGION=
export SQLITE_DATABASE_PATH=