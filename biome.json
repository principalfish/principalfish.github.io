{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**/*.js", "**/*.mjs", "!**/*.min.js", "!**/vendor"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": false
  },
  "css": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "json": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "html": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  }
}
