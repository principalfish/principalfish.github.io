{
  "audit_date": "2026-10-22",
  "checkout": "35e527a1",
  "method": "SQLite mode=ro, PRAGMA query_only=ON, one read transaction; no model run or writes. SQL inventory counts are not selected-contributor counts.",
  "queries": {
    "maps": "SELECT m.id,m.name,m.parliament,COUNT(s.id) AS units FROM maps m LEFT JOIN seats s ON s.map_id=m.id WHERE m.parliament LIKE 'us_%' GROUP BY m.id",
    "poll_coverage": "SELECT map_id,CASE WHEN seat_id IS NULL THEN 'national' ELSE 'seat' END AS scope,COUNT(*) AS polls,SUM(sample_size IS NULL OR sample_size<=0) AS unresolved_n,MIN(fieldwork_end) AS first_end,MAX(fieldwork_end) AS last_end,SUM(source_url IS NULL OR source_url='') AS missing_url,SUM(matchup IS NULL OR matchup='') AS missing_matchup FROM polls WHERE map_id IN (21,22,23) GROUP BY map_id,scope",
    "missing_individual_n": "SELECT p.id,p.map_id,s.seat_name,p.fieldwork_end,p.matchup,p.source_url FROM polls p LEFT JOIN seats s ON s.id=p.seat_id WHERE p.map_id IN (21,22,23) AND (p.sample_size IS NULL OR p.sample_size<=0) AND NOT(p.map_id=21 AND p.seat_id IS NULL) ORDER BY p.map_id,p.id",
    "poll_bases": "SELECT p.map_id,COUNT(b.id) AS bases FROM polls p JOIN poll_bases b ON b.poll_id=p.id WHERE p.map_id IN (21,22,23) GROUP BY p.map_id",
    "tracked_national": "SELECT * FROM tracked_matchups WHERE map_id IN (21,22,23) AND seat_id IS NULL",
    "tracked_seat_counts": "SELECT map_id,source,COUNT(*) AS scopes,SUM(matchup IS NULL OR matchup='') AS ignored FROM tracked_matchups WHERE map_id IN (21,22,23) AND seat_id IS NOT NULL GROUP BY map_id,source",
    "presidential_matchups": "SELECT p.matchup,COUNT(*) AS polls,SUM(p.sample_size IS NULL OR p.sample_size<=0) AS unresolved_n,CASE WHEN p.seat_id IS NULL THEN 'national' ELSE 'seat' END AS scope FROM polls p WHERE p.map_id=22 GROUP BY p.matchup,scope",
    "historical_results": "SELECT e.id,e.name,e.map_id,e.year,e.type,COUNT(DISTINCT v.seat_id) AS units FROM elections e LEFT JOIN votes v ON v.election_id=e.id WHERE e.map_id IN (21,22,23) AND e.type NOT LIKE '%model%' GROUP BY e.id ORDER BY e.map_id,e.year",
    "model_history": "SELECT map_id,type,COUNT(*) AS runs,MIN(election_date) AS first_date,MAX(election_date) AS last_date,MIN(year) AS first_year,MAX(year) AS last_year FROM elections WHERE map_id IN (21,22,23) AND type LIKE '%model%' GROUP BY map_id,type",
    "pre_2024_polls": "SELECT map_id,COUNT(*) AS polls FROM polls WHERE map_id IN (21,22,23) AND fieldwork_end < '2024-11-05' GROUP BY map_id",
    "ev_eras": "SELECT e.census_year,e.first_election_year,e.last_election_year,COUNT(a.unit_name) AS units,SUM(a.electoral_votes) AS electoral_votes FROM us_electoral_vote_eras e JOIN us_electoral_vote_allocations a ON a.era_year=e.census_year GROUP BY e.census_year",
    "house_single_party_baselines": "SELECT s.seat_name,COUNT(DISTINCT v.party_id) AS parties FROM votes v JOIN elections e ON e.id=v.election_id JOIN seats s ON s.id=v.seat_id WHERE e.name='2024 US House Election' AND v.vote_total>0 GROUP BY s.id HAVING COUNT(DISTINCT v.party_id)=1 ORDER BY s.seat_name",
    "schema_columns": "SELECT name FROM pragma_table_info('polls')",
    "stored_uncertainty": "SELECT e.map_id,u.schema,COUNT(*) AS runs FROM model_uncertainty u JOIN elections e ON e.id=u.election_id WHERE e.map_id IN (21,22,23) GROUP BY e.map_id,u.schema",
    "missing_n_current_window_matchup": "SELECT p.id,p.map_id,s.seat_name,p.fieldwork_end,p.matchup,t.matchup AS tracked_matchup FROM polls p JOIN seats s ON s.id=p.seat_id LEFT JOIN tracked_matchups t ON t.map_id=p.map_id AND t.seat_id=p.seat_id WHERE p.map_id IN(21,23) AND (p.sample_size IS NULL OR p.sample_size<=0) AND p.fieldwork_end BETWEEN date('2026-10-19','-60 days') AND '2026-10-19' ORDER BY p.map_id,p.id",
    "presidential_target_cycles": "SELECT target_election_year,COUNT(*) AS runs FROM elections WHERE type='us_presidential_model' GROUP BY target_election_year",
    "generic_sources": "SELECT s.name,COUNT(*) AS snapshots FROM polls p JOIN pollsters s ON p.pollster_id=s.id WHERE map_id=21 AND seat_id IS NULL GROUP BY s.id",
    "baseline_party_mapping": "SELECT DISTINCT p.id,p.name,p.short_name FROM parties p JOIN votes v ON v.party_id=p.id JOIN elections e ON e.id=v.election_id WHERE e.map_id IN (21,22,23) AND e.type NOT LIKE '%model%' ORDER BY p.id"
  },
