  },
  "parameters": [
    {
      "name": "design_effect",
      "value": 1.5,
      "unit": "×",
      "source": "literature",
      "meaning": "Variance inflation from weighting; n is divided by it. UK online panels run at about 1.5-2.",
      "derivation": "1.5 ×: Variance inflation from weighting; n is divided by it. UK online panels run at about 1.5-2. (literature; not fitted here)."
    },
    {
      "name": "n_eff_cap",
      "value": 3000.0,
      "unit": "respondents",
      "source": "setting",
      "meaning": "Largest effective n one poll or crossbreak may have, so a mis-parsed n cannot claim near-zero error.",
      "derivation": "3000.0 respondents: Largest effective n one poll or crossbreak may have, so a mis-parsed n cannot claim near-zero error. (setting; not fitted here)."
    },
    {
      "name": "interval",
      "value": 0.9,
      "unit": "probability",
      "source": "setting",
      "meaning": "Central probability of every reported interval.",
      "derivation": "0.9 probability: Central probability of every reported interval. (setting; not fitted here)."
    },
    {
      "name": "p_ref",
      "value": 0.3,
      "unit": "proportion",
      "source": "setting",
      "meaning": "Share at which every σ is quoted; s(p) scales it to other shares.",
      "derivation": "0.3 proportion: Share at which every σ is quoted; s(p) scales it to other shares. (setting; not fitted here)."
    },
    {
      "name": "decided_fraction",
      "value": 0.8,
      "unit": "fraction",
      "source": "calibrated",
      "meaning": "Share of an all-adult base or total sample who name a party (multiplies those n before the design effect).",
      "derivation": "0.8: the share of a total sample who name a party. Mean of decided base ÷ sample size over 34 polls (bmg_research 0.86 (1), focaldata 0.89 (4), ipsos 0.84 (1), more_in_common 0.75 (15), survation 0.81 (13)); bases equal to the sample size (Opinium) and weighted-only bases (Find Out Now) left out."
    },
    {
      "name": "likely_voters_fraction",
      "value": 0.9,
      "unit": "fraction",
      "source": "guess",
      "meaning": "Share of a likely-voter base who name a party.",
      "derivation": "0.9 fraction: Share of a likely-voter base who name a party. (guess; not fitted here)."
    },
    {
      "name": "sigma_nat",
      "value": 2.94,
      "unit": "points at p_ref",
      "source": "calibrated",
      "meaning": "SD of the industry-wide polling error, shared by every region.",
      "derivation": "2.94 pt (raw, engine units): the industry-wide polling error drawn for a party on 30%. Realised 2.55 = RMS of 35 party × election misses z = (A − R)/s(R) over 9 general elections 1992–2024, each election weighted equally (final polls and results: Mark Pack, PollBase); with each z first divided by its own party's share of a raw error kept after the engine's centring (at that election's results; median 0.821 for the two largest parties, 0.927 for the rest)."
    },
    {
      "name": "sigma_reg",
      "value": 1.5,
      "unit": "points at p_ref",
      "source": "guess",
      "meaning": "SD of a region's own polling error beyond sampling. No historical regional poll data to calibrate it.",
      "derivation": "1.5 points at p_ref: SD of a region's own polling error beyond sampling. No historical regional poll data to calibrate it. (guess; not fitted here)."
    },
    {
      "name": "sigma_seat",
      "value": 4.9,
      "unit": "points at p_ref",
      "source": "calibrated",
      "meaning": "SD of a seat's departure from its region's swing.",
      "derivation": "4.9 pt (raw, engine units): the seat noise drawn for a party on 30%. Realised 4.41 = 1.4826 × MAD of 11304 residuals u (seat change left after the fitted swing type, scaled by s(predicted share)) pooled over 4 pairs (per pair: 2010→2015 4.32, 2015→2017 4.18, 2017→2019 3.65, 2019n→2024 5.71); the raw value takes each u first divided by its own cell's share of a raw error kept after the engine's centring (median 0.822 for a seat's two leading parties, 0.962 for the rest)."
    },
    {
      "name": "sigma_lambda",
      "value": 0.38,
      "unit": "λ (0 uniform, 1 proportional)",
      "source": "calibrated",
      "meaning": "SD of the swing-type factor shared by all seats in a simulation.",
      "derivation": "0.38: how far the swing type (0 uniform, 1 proportional) moves between elections. RMS of λ̂ over 4 same-boundary pairs (2010→2015 +0.24, 2015→2017 +0.44, 2017→2019 +0.12, 2019n→2024 +0.57); their mean +0.34 is reported, not applied."
    },
    {
      "name": "lambda_min_share",
      "value": 1.0,
      "unit": "points",
      "source": "setting",
      "meaning": "Smallest regional baseline at which a party's swing can be proportional (Others always additive).",
      "derivation": "1.0 points: Smallest regional baseline at which a party's swing can be proportional (Others always additive). (setting; not fitted here)."
    },
    {
      "name": "min_polled_share",
      "value": 0.5,
      "unit": "points",
      "source": "setting",
      "meaning": "Regional poll average below which a party counts as not polled there.",
      "derivation": "0.5 points: Regional poll average below which a party counts as not polled there. (setting; not fitted here)."
    },
    {
      "name": "simulations",
      "value": 10000,
      "unit": "count",
      "source": "setting",
      "meaning": "Simulated elections per model run.",
      "derivation": "10000 count: Simulated elections per model run. (setting; not fitted here)."
    },
    {
      "name": "chunk_size",
      "value": 1000,
      "unit": "count",
      "source": "setting",
      "meaning": "Simulations drawn at once (bounds memory).",
      "derivation": "1000 count: Simulations drawn at once (bounds memory). (setting; not fitted here)."
    },
    {
      "name": "majority_threshold",
      "value": 326,
      "unit": "seats",
      "source": "setting",
      "meaning": "Seats needed for a majority.",
      "derivation": "326 seats: Seats needed for a majority. (setting; not fitted here)."
    }
  ],
